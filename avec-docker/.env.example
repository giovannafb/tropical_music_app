# Version Docker — copier ce fichier en avec-docker/.env (non versionné) et remplacer toutes les valeurs « change-me ».
# Mots de passe MySQL : lettres et chiffres uniquement (ils sont insérés dans une URL de connexion).

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=musicapp
MYSQL_USER=musicapp
MYSQL_PASSWORD=change-me

# Clé de signature des JWT (longue chaîne aléatoire, ex. : python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me-with-a-long-random-string

# URL publique du site (liens envoyés par email)
PUBLIC_URL=http://localhost

# Cookies « Secure » : true en production (HTTPS). Les navigateurs les acceptent aussi sur http://localhost.
COOKIE_SECURE=true

# Nombre de répliques par index Elasticsearch (2 avec le cluster de 3 nœuds)
ES_REPLICAS=2

# Workers gunicorn par instance d'API (= nombre de cœurs)
WEB_CONCURRENCY=2

# SMTP : Mailpit en développement. Production : Gmail (mot de passe d'application), Brevo…
MAIL_FROM=MusicApp <no-reply@musicapp.local>
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false

# Scripts
ADMIN_PASSWORD=change-me-admin
SEED_ARTIST_PASSWORD=change-me-artists
