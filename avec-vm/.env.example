# Version VM (3 machines virtuelles VirtualBox). Au premier lancement, installer.sh copie ce fichier
# en avec-vm/.env (non versionné) et remplace chaque « change-me » par une valeur aléatoire.
# Il est indépendant de avec-docker/.env et de sans-docker/.env : chaque version a ses propres données.
# Mots de passe : lettres, chiffres, « - » et « _ » uniquement (ils sont insérés dans des URL et des fichiers de configuration).

# MySQL (vm-donnees). L'utilisateur n'a le droit de se connecter que depuis vm-metier.
MYSQL_DATABASE=musicapp
MYSQL_USER=musicapp
MYSQL_PASSWORD=change-me

# Redis (vm-donnees). Mot de passe obligatoire : Redis est joignable par le réseau privé.
REDIS_PASSWORD=change-me

# Clé de signature des JWT
JWT_SECRET=change-me

# Cookies « Secure » : le site s'ouvre sur http://localhost:8081 (redirection de port VirtualBox),
# adresse sur laquelle les navigateurs les acceptent.
COOKIE_SECURE=true

# Nombre d'instances d'API sur vm-metier (1 à 9) et workers gunicorn par instance
API_INSTANCES=3
WEB_CONCURRENCY=2

# Expéditeur des emails (capturés par Mailpit sur vm-metier : http://localhost:8027)
MAIL_FROM="MusicApp <no-reply@musicapp.local>"

# Scripts (create_admin, seed_fma)
ADMIN_PASSWORD=change-me
SEED_ARTIST_PASSWORD=change-me

# Mot de passe de l'utilisateur « ubuntu » des VM, pour la console VirtualBox (SSH utilise une clé)
VM_PASSWORD=change-me

# Mémoire (Mo) et processeurs de chaque VM, appliqués à chaque démarrage.
# WSL dispose d'environ 7,6 Go : pour augmenter ces valeurs, augmenter d'abord memory= dans
# C:\Users\<toi>\.wslconfig (puis wsl --shutdown).
RAM_PRESENTATION=512
RAM_METIER=1536
RAM_DONNEES=2560
CPU_PRESENTATION=1
CPU_METIER=2
CPU_DONNEES=2
