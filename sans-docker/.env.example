# Version sans Docker — copier ce fichier en sans-docker/.env (non versionné) et remplacer les valeurs « change-me ».
# Il est indépendant de avec-docker/.env : chaque version a sa propre base de données et ses propres comptes.

# MySQL local (la base et l'utilisateur sont créés par installer.sh)
MYSQL_DATABASE=musicapp
MYSQL_USER=musicapp
MYSQL_PASSWORD=change-me

# Clé de signature des JWT (longue chaîne aléatoire, ex. : python3 -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me-with-a-long-random-string

# Cookies « Secure » : les navigateurs les acceptent sur http://localhost
COOKIE_SECURE=true

# Nombre d'instances d'API derrière Nginx (1 à 9) et workers gunicorn par instance
API_INSTANCES=3
WEB_CONCURRENCY=2

# Expéditeur des emails (capturés par Mailpit : http://localhost:8026)
MAIL_FROM="MusicApp <no-reply@musicapp.local>"

# Scripts (create_admin, seed_fma)
ADMIN_PASSWORD=change-me-admin
SEED_ARTIST_PASSWORD=change-me-artists
